# Copy this file to `.env` (never commit `.env` to Git!)
# Generate strong random secrets with:
#   PYTHONPATH=src python3 -m trade_order_engine.security

# Output OrderBook .txt path
ORDERBOOK_FILE_PATH=data/OrderBook.txt

# Internal client_id injected server-side into `.txt` rows (NEVER exposed publicly in API)
ORDER_CLIENT_ID=replace-with-your-internal-client-id

# Authentication (fail-closed by default: server refuses to start without a key)
ORDER_AUTH_ENABLED=true
ORDER_API_KEY=replace-with-strong-random-api-key
# Optional: comma-separated keys for zero-downtime key rotation
# ORDER_API_KEYS=primary-key,secondary-key

# Optional extra layer: HMAC-SHA256 request signing (anti-tamper + anti-replay)
# ORDER_HMAC_SECRET=replace-with-strong-random-hmac-secret
ORDER_HMAC_MAX_SKEW_SECONDS=30

# Optional IP / CIDR allowlist (e.g. your person's static IP or Tailscale subnet)
# ORDER_ALLOWED_IPS=127.0.0.1,203.0.113.42,100.64.0.0/10
# Set true ONLY when running behind a reverse proxy (Nginx/Caddy) on trusted proxy IPs
ORDER_TRUST_PROXY_HEADERS=false
ORDER_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Abuse protection & production hardening
ORDER_RATE_LIMIT_PER_MINUTE=60
ORDER_MAX_BODY_BYTES=65536
ORDER_ENABLE_DOCS=false
